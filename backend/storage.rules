rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // صور الموقع: أي حد يشوفها، وصاحبة الحساب بس ترفع/تمسح
    match /site/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'neweradentalclinics@gmail.com'
        && (request.resource == null || (request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
    // أي حاجة تانية مقفولة
    match /{all=**} {
      allow read, write: if false;
    }
  }
}

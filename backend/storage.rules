rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // صور الموقع: أي حد يشوفها، وصاحبة الحساب بس ترفع/تمسح
    match /site/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'neweradentalclinics@gmail.com'
        && (request.resource == null || (request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
    // ===== ملفات المرضى (v4.6): أشعة وصور وموافقات متصورة =====
    // الرفع: أي موظف داخل بحسابه (لحد 15 ميجا). الفتح: الإدارة + الدكتور المسؤول/الوصول الطارئ + اللي رفعه + تمريض مريض النهارده
    function staffA() { return firestore.get(/databases/(default)/documents/staff_auth/$(request.auth.uid)).data; }
    function isStaffS() { return request.auth != null && firestore.exists(/databases/(default)/documents/staff_auth/$(request.auth.uid)); }
    function pt(pid) { return firestore.get(/databases/(default)/documents/patients/$(pid)).data; }
    match /patients/{pid}/{file} {
      allow create: if isStaffS() && request.resource.size < 15 * 1024 * 1024
        && file.matches('^[0-9]+_' + request.auth.uid + '_.*');
      allow read: if request.auth != null && (
        request.auth.token.email == 'neweradentalclinics@gmail.com'
        || (isStaffS() && (staffA().role in ['admin', 'superadmin']
          || file.matches('^[0-9]+_' + request.auth.uid + '_.*')
          || (staffA().role == 'doctor' && (pt(pid).get('doctorId', '') == staffA().staffId || staffA().staffId in pt(pid).get('doctorIds', [])
              || (firestore.exists(/databases/(default)/documents/patients/$(pid)/emergency/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/patients/$(pid)/emergency/$(request.auth.uid)).data.until > request.time)))
          || (staffA().role == 'employee' && pt(pid).get('visit', null) != null && pt(pid).visit.from <= request.time.toMillis() && request.time.toMillis() < pt(pid).visit.to))));
      allow delete: if isStaffS() && staffA().role in ['admin', 'superadmin'];
    }
    // أي حاجة تانية مقفولة
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
